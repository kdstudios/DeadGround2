{
  "name": "deadground",
  "version": "0.11.0",
  "private": true,
  "description": "DeadGround - Minesweeper Adventure meets a zombie apocalypse",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch --preserveWatchOutput",
    "test": "tsc -p . && node --test \"tests/*.test.mjs\"",
    "serve": "node tools/serve.mjs",
    "start": "tsc -p . && node tools/serve.mjs",
    "dev": "node tools/dev.mjs",
    "validate": "tsc -p . && node tools/validate.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
